<?xml version="1.0" encoding="UTF-8"?>
<!-- ~/Library/LaunchAgents/local.homelab.pull.plist  (a job missed while the Mac slept runs on wake) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.homelab.pull</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/<mac-user>/bin/homelab-pull.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>/Users/<mac-user>/homelab-backup/launchd-error.log</string>
</dict>
</plist>
